# Local development: leave DATABASE_URL empty to use SQLite.
# Supabase/Vercel: set the private Transaction pooler URI from Supabase Connect.
# Never prefix these names with NEXT_PUBLIC_.
DATABASE_URL=
# Required for first administrator creation on Vercel; choose at least 32 random characters.
ADMIN_SETUP_TOKEN=
# Optional: PEM CA certificate if required by your PostgreSQL host. TLS verification stays enabled.
DATABASE_CA_CERT=
# Local SQLite directory only; not used when DATABASE_URL is set.
# LIVREX_DATA_DIR=.data

# Optional local browser demo (used automatically on Vercel when DATABASE_URL is absent).
# LIVREX_DEMO_MODE=1
